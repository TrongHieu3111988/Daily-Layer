{
  // Static shop served as Worker assets from ./public; Cloudflare Workers Builds runs `npx wrangler deploy` on every push to main.
  // worker.js runs first ONLY for the paths in run_worker_first (verification files that must be served at an exact .html path).
  "name": "dailylayer",
  "main": "worker.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/googlea402708d99025b1d.html"]
  }
}
